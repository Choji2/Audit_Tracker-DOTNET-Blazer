@using AAP_SD
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer



<MudNavMenu>
    <MudPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <MudNavMenu Color="Color.Dark" Class="mud-width-full">
            <AuthorizeView>
                <Authorized>
                    <MudText Class="px-3" Color="Color.Dark" Typo="Typo.body2">@context.User.Identity.Name</MudText>
                </Authorized>
                <NotAuthorized>
                </NotAuthorized>
            </AuthorizeView>
           
        <AuthorizeView Policy="@SD.Master">
            <Authorized>
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
                    <MudNavLink Href="/master" Icon="@Icons.Material.Filled.EditNote">Master Page</MudNavLink>
            </Authorized>
            <NotAuthorized>
                    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
                    <MudNavLink  Disabled="true" Href="/master" Icon="@Icons.Material.Filled.EditNote">Master Page</MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavMenu>
</MudPaper>
</MudNavMenu>
