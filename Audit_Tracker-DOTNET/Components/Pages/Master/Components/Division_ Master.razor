@using AAP_Authentication
@using AAP_SD
@using Microsoft.AspNetCore.Components.Authorization
@using Models.DB_objects
@using Services.DB_Services
@inject DB_Services _dbService


<MudPaper Elevation="0" Outlined="true" Class="px-3 py-3" style="height:750px;width:100%;overflow-y:scroll">

    <MudGrid>
        <MudItem sm="6">
            <MudPopover OverflowBehavior="OverflowBehavior.FlipNever" Open="@_open" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter" Class="pa-4">
                <MudText Typo="Typo.h6"> Removing Division ID: @selected.ID </MudText>
                <MudGrid>
                    @if (del_loading)
                    {
                        <MudItem sm="12">
                            <MudProgressLinear Color="Color.Dark" Striped="true" Rounded="true" Value="100" Class="my-7" Size="Size.Medium" />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem sm="6">
                            <MudButton StartIcon="@Icons.Material.Filled.ArrowLeft" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" OnClick="@(ToggleOpen)">Exit</MudButton>
                        </MudItem>
                        <MudItem sm="6">
                            <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Info" OnClick="@(DeleteDivision)">Delete</MudButton>
                        </MudItem>
                    }



                </MudGrid>
            </MudPopover>
            <MudTable Items="@Divisions" Height="550px" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Divisions</MudText>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Division</MudTh>
                    <MudTh>Code</MudTh>
                    <MudTh>DESC</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Username">@context.ID</MudTd>
                    <MudTd DataLabel="Name">@context.Div_Code</MudTd>
                    <MudTd DataLabel="Name">@context.Desc </MudTd>


                    <MudTd> <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" Disabled="false" OnClick="@(()=>ToggleDelete(context).GetAwaiter())">Delete</MudButton></MudTd>



                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudItem>
        <MudItem sm="6">
            <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" sm="7">
                        <MudCard Outlined="true" Elevation="0">

                            <MudCardContent>
                                <MudTextField Label="Division Code" HelperText="Code for Division"
                                @bind-Value="model.Div_Code" For="@(() => model.Div_Code)" />
                                <MudTextField Label="Desc" HelperText="About Division"
                                @bind-Value="model.Desc" For="@(() => model.Desc)" />

                            </MudCardContent>

                            <MudCardActions>
                               @if(add_load){
                                    <MudProgressLinear Color="Color.Dark" Striped="true" Rounded="true" Value="100" Class="my-7" Size="Size.Medium" />
                               }else{
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" FullWidth="true" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Dark" Class="ml-auto">Add</MudButton>
                               }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mud-height-full">
                            <MudText Color="@Color.Error">
                                <ValidationSummary />
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudItem>
    </MudGrid>

</MudPaper>





@code {

    AAP_Divisions model;
    AAP_Divisions selected;
    List<AAP_Divisions> Divisions = new();

    bool add_load = false;
    bool del_loading = false;

    protected override async Task OnInitializedAsync()
    {

        await SetVariables();

    }

    private async Task SetVariables()
    {
        model = new();
        Divisions = await _dbService.GetAllDivisions();
        StateHasChanged();
    }

    async Task CreateDivision()
    {

        add_load= true;
        StateHasChanged();
        await Task.Delay(1000);
        var user = await _dbService.GetSingleDivision(model.ID);

        if (user == null)
        {

            await _dbService.DivisionCreation(model);
        }
        add_load=false;
        await SetVariables();
        
    }

    async Task DeleteDivision()
    {
        del_loading = true;
        StateHasChanged();

        await Task.Delay(2000);
        await _dbService.DivisionDelete(selected);

        del_loading = false;
        SetVariables();
        ToggleOpen();
    }

    async Task ToggleDelete(AAP_Divisions divisiion)
    {
        selected = divisiion;
        ToggleOpen();

    }

    private async void OnValidSubmit(EditContext context)
    {
        await CreateDivision();
        StateHasChanged();
    }

   
    bool _open = false;
    private void ToggleOpen()
    {
        _open = !_open;
    }


}