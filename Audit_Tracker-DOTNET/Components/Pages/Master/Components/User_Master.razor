@using AAP_Authentication
@using AAP_SD
@using Microsoft.AspNetCore.Components.Authorization
@using Models.DB_objects
@using Services.DB_Services
@inject Admin_Services _dbService


<MudPaper Elevation="0" Outlined="true" Class="px-3 py-3" style="height:750px;width:100%;overflow-y:scroll">


    <MudGrid>
        <MudItem sm="6">
            <MudPopover OverflowBehavior="OverflowBehavior.FlipNever" Open="@_open" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter" Class="pa-4">
                <MudText Typo="Typo.h6"> Removing User ID: @selected.Username </MudText>
                <MudGrid>
                    @if (del_loading)
                    {
                        <MudItem sm="12">
                            <MudProgressLinear Color="Color.Dark" Striped="true" Rounded="true" Value="100" Class="my-7" Size="Size.Medium" />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem sm="6">
                            <MudButton StartIcon="@Icons.Material.Filled.ArrowLeft" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" OnClick="@(ToggleOpen)">Exit</MudButton>
                        </MudItem>
                        <MudItem sm="6">
                            <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Info" OnClick="@(DeleteUser)">Delete</MudButton>
                        </MudItem>
                    }



                </MudGrid>
            </MudPopover>
            <MudTable Items="@Users" Height="550px" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Users</MudText>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Username</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Role</MudTh>


                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Username">@context.Username</MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Role">@Roles.SingleOrDefault(x => x.ID == context.RoleID).Code</MudTd>
                    <AuthorizeView Context="Auth">
                        @if (Auth.User.Identity.Name.Substring(SD.UserDomain.Length) != context.Username)
                        {
                            <MudTd> <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" OnClick="@(()=>DeleteToggle(context).GetAwaiter())">Delete</MudButton></MudTd>
                        }
                        else
                        {
                            <MudTd> <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" Disabled="true">Delete</MudButton></MudTd>
                        }
                    </AuthorizeView>

                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudItem>
        <MudItem sm="6">
            <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" sm="7">
                        <MudCard Outlined="true" Elevation="0">

                            <MudCardContent>
                                <MudTextField Label="Username" HelperText="Username"
                                @bind-Value="model.Username" For="@(() => model.Username)" />
                                <MudTextField Label="Full Name" HelperText="Inventory Name"
                                @bind-Value="model.Name" For="@(() => model.Name)" />
                                <MudRadioGroup T="int" @bind-Value="model.RoleID" For="@(() => model.RoleID)">
                                    @foreach (var role in Roles)
                                    {
                                        <MudRadio Value="@role.ID">@role.Code</MudRadio>
                                    }
                                </MudRadioGroup>
                                <MudText Typo="Typo.caption">*One entry per username</MudText>
                            </MudCardContent>

                            <MudCardActions>
                                @if(add_load){
                                    <MudProgressLinear Color="Color.Dark" Striped="true" Rounded="true" Value="100" Class="my-7" Size="Size.Medium" />
                                }else{

                                    <MudButton StartIcon="@Icons.Material.Filled.Add" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Dark" Class="ml-auto">Add</MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mud-height-full">
                            <MudText Color="@Color.Error">
                                <ValidationSummary />
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudItem>
    </MudGrid>


</MudPaper>





@code {

    private IEnumerable<Inventories> elements = new List<Inventories>();
    Audit_Admins model;
    Audit_Admins selected;
    List<Audit_Admins> Users = new();
    List<Roles> Roles = new();

    bool add_load = false;
    bool del_loading = false;

    protected override async Task OnInitializedAsync()
    {

        await SetVariables();

    }

    private async Task SetVariables()
    {
        model = new();
        model.RoleID = 2;
        Users = await _dbService.GetAllUsers();
        Roles = await _dbService.GetAllRoles();
        StateHasChanged();
    }

    async Task CreateUser()
    {
        add_load = true;
        StateHasChanged();
        await Task.Delay(3000);

        var user = await  _dbService.GetAdmin(model.Username);
        if( user == null){

            await _dbService.CreateAdmin(model);
        }
        add_load = false;
        await SetVariables();
    }

    async Task DeleteUser()
    {
        del_loading = true;
        StateHasChanged();
        await Task.Delay(1000);
        await _dbService.DeleteUser(selected.Username);     
        SetVariables();
        del_loading = false;
        ToggleOpen();

    }
    async Task DeleteToggle(Audit_Admins user){

        selected = user;
        ToggleOpen();
        StateHasChanged();

    }

    private async void OnValidSubmit(EditContext context)
    {
        await CreateUser();
        StateHasChanged();
    }


    bool _open = false;
    private void ToggleOpen()
    {
        _open = !_open;
    }

}