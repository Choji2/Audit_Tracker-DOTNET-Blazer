@using Models.DB_objects
@using Services.DB_Services
@inject DB_Services _dbService



<MudPaper Elevation="0" Outlined="true" Class="px-3 py-3" style="height:750px;width:100%;overflow-y:scroll">

    <MudGrid>

        <MudItem sm="6">
            <MudPopover OverflowBehavior="OverflowBehavior.FlipNever" Open="@_open" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.CenterCenter" Class="pa-4">
                <MudText Typo="Typo.h6"> Removing Inventory ID: @selected.ID </MudText>
                <MudGrid>
                    @if(del_loading){
                        <MudItem sm="12">
                            <MudProgressLinear Color="Color.Dark" Striped="true" Rounded="true" Value="100" Class="my-7" Size="Size.Medium" />
                        </MudItem>
                    }else{
                        <MudItem sm="6">
                            <MudButton StartIcon="@Icons.Material.Filled.ArrowLeft" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" OnClick="@(ToggleOpen)">Exit</MudButton>
                        </MudItem>
                        <MudItem sm="6">
                            <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Info" OnClick="@(DeleteAction)">Delete</MudButton>
                        </MudItem>
                    }



                </MudGrid>
            </MudPopover>
            <MudTable Items="@Inv_List" Height="550px" Dense="true" Hover="true" Bordered="true" Striped="true" Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Inventory</MudText>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>DESC</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nr">@context.ID</MudTd>
                    <MudTd DataLabel="Sign">@context.desc</MudTd>
                    <MudTd> <MudButton StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" Variant="Variant.Filled" Color="Color.Dark" OnClick="@(()=>DeleteInventory(context).GetAwaiter())">Delete</MudButton></MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudItem>
        <MudItem sm="6">
            <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" sm="7">
                        <MudCard Outlined="true" Elevation="0">
                            <MudCardContent>
                                <MudTextField Label="Inventory Name" HelperText="Inventory Name"
                                @bind-Value="model.desc" For="@(() => model.desc)" />
                            </MudCardContent>
                            <MudCardActions>
                                @if(add_load ){
                                    <MudProgressLinear Color="Color.Dark" Striped="true" Rounded="true" Value="100" Class="my-7" Size="Size.Medium" />
                                }else{

                                    <MudButton StartIcon="@Icons.Material.Filled.Add" FullWidth="true" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Dark" Class="ml-auto">Add</MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mud-height-full">
                            <MudText Color="@Color.Error">
                                <ValidationSummary />
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudItem>
    </MudGrid>
</MudPaper>




@code {

    private bool _open= false;


    private IEnumerable<Inventories> elements = new List<Inventories>();
    Inventories model;
    Inventories selected;

    bool add_load = false;
    bool del_loading = false;

    List<Inventories> Inv_List = new();
    List<Divisions> DivisionList = new();

    protected override async Task OnInitializedAsync()
    {

        await SetVariables();

    }

    private async Task SetVariables()
    {
        model = new();
        Inv_List = await _dbService.GetAllInventories();
        StateHasChanged();
    }

    async Task CreateInventory()
    {
        add_load = true;
        StateHasChanged();
        var zones = await _dbService.GetAllZones();
        List<Inventory_Records> new_records = new();
        Inventories new_inv = new()
            {
                ID = _dbService.IDGenerator(),
                desc = model.desc
            };

        foreach (var zone in zones)
        {
            new_records.Add(
                new()
                    {
                        ID = _dbService.IDGenerator(),
                        Status = 0,
                        ZoneID = zone.ID,
                        INVID = new_inv.ID
                    }
            );
        }
        new_inv.Records = new_records;
        var stat = await _dbService.AddInventory(new_inv);
        Task.Delay(500);
        await SetVariables();

        add_load = false;
        StateHasChanged();
    }

    async Task DeleteInventory(Inventories inv)
    {
        selected = inv;
        ToggleOpen();
        SetVariables();

    }
    async Task DeleteAction(){
        del_loading = true;
        StateHasChanged();
        await Task.Delay(1000);
        del_loading = false;
        await _dbService.DeleteInventory(selected);
        selected = new();
        await SetVariables();
        ToggleOpen();

    }

    private async void OnValidSubmit(EditContext context)
    {
        await CreateInventory();
        StateHasChanged();
    }



    private void ToggleOpen()
    {
        _open = !_open;      
    } 

}